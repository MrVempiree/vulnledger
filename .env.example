# VulnLedger environment configuration.
# Copy this file to .env and fill in real values. Never commit .env.

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database (PostgreSQL required)
# Provide a real connection string. Example:
# DATABASE_URL=postgres://vulnledger:CHANGE_ME@localhost:5432/vulnledger
DATABASE_URL=

# Session security
# Generate with: openssl rand -base64 32
SESSION_SECRET=
SESSION_COOKIE_NAME=vulnledger_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax

# CSRF
CSRF_SECRET=

# Import limits (documented defaults)
IMPORT_MAX_SIZE_MIB=2
IMPORT_MAX_RECORDS=5000

# Admin bootstrap
# The first administrator is created via `pnpm --filter api admin:create`.
# There is no built-in/default administrator password.
